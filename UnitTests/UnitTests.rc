// UnitTests.rc : resources of the CryptLibraryDemo unit tests.
//
// The code under test runs inside the test module, so the module has to carry the
// same standard MFC string resources as the application. MFC needs them, for
// example, to describe a CFileException.

#include "afxres.h"

#define _AFX_NO_SPLITTER_RESOURCES
#define _AFX_NO_OLE_RESOURCES
#define _AFX_NO_TRACKER_RESOURCES
#define _AFX_NO_PROPERTY_RESOURCES

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#include "afxres.rc"      // Standard components
